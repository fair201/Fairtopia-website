<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fairtopia - Video Platform</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            yt: {
              red: '#FF0000',
              darkBg: '#0f0f0f',
              darkCard: '#1f1f1f',
              darkHover: '#272727',
              darkBorder: '#3f3f3f',
              lightBg: '#f9f9f9',
              lightCard: '#ffffff',
              lightHover: '#f2f2f2',
              lightBorder: '#e5e5e5'
            }
          }
        }
      }
    }
  </script>
  <style>
    /* Strict global font weight rule: absolutely no bold text */
    * {
      font-weight: 400 !important;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-weight: 400 !important;
    }
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  </style>
</head>
<body class="bg-yt-lightBg dark:bg-yt-darkBg text-gray-900 dark:text-gray-100 min-h-screen flex flex-col transition-colors duration-200">

  <!-- Header Section -->
  <header class="sticky top-0 z-40 bg-white dark:bg-yt-darkBg border-b border-yt-lightBorder dark:border-yt-darkBorder px-4 h-14 flex items-center justify-between gap-4">
    <!-- Left Logo & Toggle Menu -->
    <div class="flex items-center gap-4">
      <button onclick="toggleSidebar()" class="p-2 rounded-full hover:bg-yt-lightHover dark:hover:bg-yt-darkHover text-gray-700 dark:text-gray-200" title="Toggle Menu">
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/></svg>
      </button>
      <a href="#" onclick="navigateTo('home'); return false;" class="flex items-center gap-2">
        <div class="w-8 h-6 bg-yt-red rounded-lg flex items-center justify-center text-white">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        </div>
        <span class="text-lg tracking-tight">Fairtopia</span>
      </a>
    </div>

    <!-- Search Bar -->
    <div class="flex-1 max-w-xl mx-2">
      <form onsubmit="handleSearch(event)" class="flex items-center w-full">
        <div class="relative w-full">
          <input type="text" id="search-input" placeholder="Search" 
                 class="w-full bg-gray-50 dark:bg-yt-darkCard border border-yt-lightBorder dark:border-yt-darkBorder rounded-l-full py-1.5 px-4 text-sm focus:outline-none focus:border-blue-500">
        </div>
        <button type="submit" class="bg-gray-100 dark:bg-yt-darkHover border border-l-0 border-yt-lightBorder dark:border-yt-darkBorder rounded-r-full px-5 py-2 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-yt-darkBorder flex items-center justify-center">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
        </button>
      </form>
    </div>

    <!-- Right Controls -->
    <div class="flex items-center gap-2">
      <!-- Dark/Light Theme Toggle -->
      <button onclick="toggleTheme()" class="p-2 rounded-full hover:bg-yt-lightHover dark:hover:bg-yt-darkHover text-gray-700 dark:text-gray-200" title="Toggle Theme">
        <svg id="theme-icon" class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4C12.92 3.04 12.46 3 12 3z"/></svg>
      </button>

      <!-- Create Video Button -->
      <button onclick="openUploadModal()" class="flex items-center gap-2 bg-gray-100 dark:bg-yt-darkHover hover:bg-gray-200 dark:hover:bg-yt-darkBorder px-3 py-1.5 rounded-full text-xs transition">
        <svg class="w-4 h-4 fill-current text-yt-red" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
        <span class="hidden sm:inline">Create</span>
      </button>

      <!-- User Profile / Auth Area -->
      <div id="user-area">
        <!-- JS Injected -->
      </div>
    </div>
  </header>

  <div class="flex flex-1 relative overflow-hidden">
    <!-- Sidebar Navigation -->
    <aside id="sidebar" class="w-56 bg-white dark:bg-yt-darkBg border-r border-yt-lightBorder dark:border-yt-darkBorder flex flex-col justify-between shrink-0 transition-all duration-200">
      <div class="p-2 space-y-1">
        <button onclick="navigateTo('home')" id="nav-home" class="nav-btn w-full flex items-center gap-4 px-3 py-2 rounded-xl text-sm bg-yt-lightHover dark:bg-yt-darkHover text-gray-900 dark:text-white">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
          <span>Home</span>
        </button>
        <button onclick="navigateTo('subscriptions')" id="nav-subscriptions" class="nav-btn w-full flex items-center gap-4 px-3 py-2 rounded-xl text-sm text-gray-600 dark:text-gray-400 hover:bg-yt-lightHover dark:hover:bg-yt-darkHover">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M18.7 8.7H5.3V7h13.4v1.7zm-2.5-4H7.8V3h8.4v1.7zM20 11H4c-.55 0-1 .45-1 1v8c0 .55.45 1 1 1h16c.55 0 1-.45 1-1v-8c0-.55-.45-1-1-1zm-9 7v-4l4 2-4 2z"/></svg>
          <span>Subscriptions</span>
        </button>
        
        <hr class="border-yt-lightBorder dark:border-yt-darkBorder my-2">

        <button onclick="viewMyChannel()" id="nav-channel" class="nav-btn w-full flex items-center gap-4 px-3 py-2 rounded-xl text-sm text-gray-600 dark:text-gray-400 hover:bg-yt-lightHover dark:hover:bg-yt-darkHover">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
          <span>Your Channel</span>
        </button>
        <button onclick="navigateTo('liked')" id="nav-liked" class="nav-btn w-full flex items-center gap-4 px-3 py-2 rounded-xl text-sm text-gray-600 dark:text-gray-400 hover:bg-yt-lightHover dark:hover:bg-yt-darkHover">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M1 21h4V9H1v12zm22-11c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L14.17 1 7.58 7.59C7.22 7.95 7 8.45 7 9v10c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-2z"/></svg>
          <span>Liked Videos</span>
        </button>
        <button onclick="navigateTo('history')" id="nav-history" class="nav-btn w-full flex items-center gap-4 px-3 py-2 rounded-xl text-sm text-gray-600 dark:text-gray-400 hover:bg-yt-lightHover dark:hover:bg-yt-darkHover">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.25 2.52.77-1.28-3.52-2.09V8z"/></svg>
          <span>History</span>
        </button>
      </div>

      <div class="p-4 text-xs text-gray-400 dark:text-gray-500 border-t border-yt-lightBorder dark:border-yt-darkBorder">
        Fairtopia Video Platform
      </div>
    </aside>

    <!-- Main Dynamic Content Container -->
    <main id="main-content" class="flex-1 overflow-y-auto p-4 md:p-6">
      <!-- Dynamic Views Rendered by JS -->
    </main>
  </div>

  <!-- One-Click Google Auth Modal -->
  <div id="auth-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="bg-white dark:bg-yt-darkCard border border-yt-lightBorder dark:border-yt-darkBorder rounded-2xl w-full max-w-sm p-6 shadow-2xl text-center relative">
      <button onclick="closeAuthModal()" class="absolute top-3 right-3 text-gray-400 hover:text-gray-600 dark:hover:text-white">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>

      <div class="w-12 h-12 bg-yt-red/10 text-yt-red rounded-full flex items-center justify-center mx-auto mb-3">
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
      </div>

      <div class="text-lg mb-1">Welcome to Fairtopia</div>
      <p class="text-xs text-gray-500 dark:text-gray-400 mb-6">Sign in with your Google account to upload and comment.</p>

      <button onclick="signInWithGoogle()" class="w-full bg-white dark:bg-yt-darkHover text-gray-700 dark:text-white border border-gray-300 dark:border-yt-darkBorder py-2.5 px-4 rounded-xl text-sm hover:bg-gray-50 dark:hover:bg-yt-darkBorder flex items-center justify-center gap-3 transition">
        <svg class="w-4 h-4" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        Sign in with Google
      </button>
    </div>
  </div>

  <!-- Video Upload Modal -->
  <div id="upload-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="bg-white dark:bg-yt-darkCard border border-yt-lightBorder dark:border-yt-darkBorder rounded-2xl w-full max-w-lg p-6 shadow-2xl relative">
      <button onclick="closeUploadModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 dark:hover:text-white">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>

      <div class="text-lg mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 fill-current text-yt-red" viewBox="0 0 24 24"><path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/></svg>
        Upload Video
      </div>

      <form onsubmit="handleVideoUpload(event)" class="space-y-4">
        <div>
          <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Video Title *</label>
          <input type="text" id="upload-title" required placeholder="Enter video title" 
                 class="w-full bg-gray-50 dark:bg-yt-darkBg border border-yt-lightBorder dark:border-yt-darkBorder rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
        </div>

        <div>
          <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Description</label>
          <textarea id="upload-desc" rows="2" placeholder="Tell viewers about your video" 
                    class="w-full bg-gray-50 dark:bg-yt-darkBg border border-yt-lightBorder dark:border-yt-darkBorder rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-blue-500 resize-none"></textarea>
        </div>

        <!-- Video Source Selection -->
        <div class="space-y-2">
          <label class="block text-xs text-gray-500 dark:text-gray-400">Video File or Web URL *</label>
          <input type="text" id="upload-url" placeholder="Paste Video URL (MP4 / WebM / direct link)" 
                 class="w-full bg-gray-50 dark:bg-yt-darkBg border border-yt-lightBorder dark:border-yt-darkBorder rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
          
          <div class="flex items-center gap-2 my-1">
            <hr class="flex-1 border-yt-lightBorder dark:border-yt-darkBorder">
            <span class="text-[10px] text-gray-400 uppercase">OR</span>
            <hr class="flex-1 border-yt-lightBorder dark:border-yt-darkBorder">
          </div>

          <label class="cursor-pointer flex items-center justify-center gap-2 bg-gray-100 dark:bg-yt-darkHover hover:bg-gray-200 dark:hover:bg-yt-darkBorder border border-yt-lightBorder dark:border-yt-darkBorder rounded-xl py-2 px-3 text-xs transition">
            <svg class="w-4 h-4 fill-current text-yt-red" viewBox="0 0 24 24"><path d="M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z"/></svg>
            Choose Video File
            <input type="file" id="upload-file" accept="video/*" class="hidden" onchange="handleFileSelect(this)">
          </label>
          <span id="file-selected-label" class="text-xs text-emerald-500 block truncate"></span>
        </div>

        <div>
          <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Thumbnail Image URL (Optional)</label>
          <input type="text" id="upload-thumb" placeholder="Paste image URL for custom thumbnail" 
                 class="w-full bg-gray-50 dark:bg-yt-darkBg border border-yt-lightBorder dark:border-yt-darkBorder rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
        </div>

        <div class="pt-2 flex justify-end gap-2">
          <button type="button" onclick="closeUploadModal()" class="px-4 py-2 rounded-xl text-xs border border-yt-lightBorder dark:border-yt-darkBorder hover:bg-gray-100 dark:hover:bg-yt-darkHover">Cancel</button>
          <button type="submit" class="bg-yt-red hover:bg-red-700 text-white px-5 py-2 rounded-xl text-xs transition">
            Publish Video
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Channel Profile Edit Modal -->
  <div id="edit-channel-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
    <div class="bg-white dark:bg-yt-darkCard border border-yt-lightBorder dark:border-yt-darkBorder rounded-2xl w-full max-w-md p-6 shadow-2xl relative">
      <button onclick="closeEditChannelModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 dark:hover:text-white">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
      </button>

      <div class="text-lg mb-4">Edit Channel Details</div>

      <form onsubmit="saveChannelEdit(event)" class="space-y-3">
        <div>
          <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Channel Name</label>
          <input type="text" id="edit-name" required class="w-full bg-gray-50 dark:bg-yt-darkBg border border-yt-lightBorder dark:border-yt-darkBorder rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
        </div>
        <div>
          <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Handle (@username)</label>
          <input type="text" id="edit-handle" required class="w-full bg-gray-50 dark:bg-yt-darkBg border border-yt-lightBorder dark:border-yt-darkBorder rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
        </div>
        <div>
          <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Avatar Image URL</label>
          <input type="text" id="edit-avatar" class="w-full bg-gray-50 dark:bg-yt-darkBg border border-yt-lightBorder dark:border-yt-darkBorder rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
        </div>
        <div>
          <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Banner Image URL</label>
          <input type="text" id="edit-banner" class="w-full bg-gray-50 dark:bg-yt-darkBg border border-yt-lightBorder dark:border-yt-darkBorder rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-blue-500">
        </div>
        <div>
          <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Channel Bio / Description</label>
          <textarea id="edit-bio" rows="2" class="w-full bg-gray-50 dark:bg-yt-darkBg border border-yt-lightBorder dark:border-yt-darkBorder rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-blue-500 resize-none"></textarea>
        </div>

        <div class="pt-2 flex justify-end gap-2">
          <button type="button" onclick="closeEditChannelModal()" class="px-4 py-2 rounded-xl text-xs border border-yt-lightBorder dark:border-yt-darkBorder hover:bg-gray-100 dark:hover:bg-yt-darkHover">Cancel</button>
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-xl text-xs">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Platform Application State Management
    let state = {
      isDarkMode: true,
      currentView: 'home',
      activeVideoId: null,
      activeChannelId: null,
      searchQuery: '',
      currentUser: JSON.parse(localStorage.getItem('ft_user')) || null,
      videos: JSON.parse(localStorage.getItem('ft_videos')) || [],
      subscriptions: JSON.parse(localStorage.getItem('ft_subscriptions')) || [],
      likedVideos: JSON.parse(localStorage.getItem('ft_liked')) || [],
      history: JSON.parse(localStorage.getItem('ft_history')) || [],
      comments: JSON.parse(localStorage.getItem('ft_comments')) || {}
    };

    let selectedFileDataUrl = null;

    window.onload = function() {
      renderUserArea();
      renderView('home');
    };

    function saveState() {
      localStorage.setItem('ft_user', JSON.stringify(state.currentUser));
      localStorage.setItem('ft_videos', JSON.stringify(state.videos));
      localStorage.setItem('ft_subscriptions', JSON.stringify(state.subscriptions));
      localStorage.setItem('ft_liked', JSON.stringify(state.likedVideos));
      localStorage.setItem('ft_history', JSON.stringify(state.history));
      localStorage.setItem('ft_comments', JSON.stringify(state.comments));
    }

    // Toggle Theme
    function toggleTheme() {
      state.isDarkMode = !state.isDarkMode;
      document.documentElement.classList.toggle('dark', state.isDarkMode);
    }

    // Sidebar Toggle
    function toggleSidebar() {
      const sidebar = document.getElementById('sidebar');
      sidebar.classList.toggle('hidden');
    }

    // Render User Avatar and Controls in Header
    function renderUserArea() {
      const container = document.getElementById('user-area');
      if (state.currentUser) {
        container.innerHTML = `
          <div class="relative group">
            <button class="flex items-center gap-2 p-1 rounded-full border border-yt-lightBorder dark:border-yt-darkBorder">
              <img src="${state.currentUser.avatar}" class="w-7 h-7 rounded-full object-cover" alt="avatar" onerror="this.src='https://placehold.co/100x100/1f1f1f/ffffff?text=User'">
            </button>
            <div class="absolute right-0 mt-1 w-48 bg-white dark:bg-yt-darkCard border border-yt-lightBorder dark:border-yt-darkBorder rounded-xl shadow-xl hidden group-hover:block p-1.5 z-50 text-xs">
              <div class="px-3 py-2 border-b border-yt-lightBorder dark:border-yt-darkBorder mb-1">
                <p class="truncate">${escapeHtml(state.currentUser.name)}</p>
                <p class="text-gray-400 truncate">${escapeHtml(state.currentUser.handle)}</p>
              </div>
              <button onclick="viewMyChannel()" class="w-full text-left px-3 py-2 rounded-lg hover:bg-yt-lightHover dark:hover:bg-yt-darkHover flex items-center gap-2">
                <svg class="w-4 h-4 fill-current text-purple-400" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                Your Channel
              </button>
              <button onclick="logout()" class="w-full text-left px-3 py-2 rounded-lg hover:bg-yt-lightHover dark:hover:bg-yt-darkHover text-red-500 flex items-center gap-2">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/></svg>
                Sign Out
              </button>
            </div>
          </div>
        `;
      } else {
        container.innerHTML = `
          <button onclick="openAuthModal()" class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-xs px-3 py-1.5 rounded-full transition">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>
            Sign In
          </button>
        `;
      }
    }

    // View Navigation Handler
    function navigateTo(view) {
      state.currentView = view;
      renderView(view);
    }

    function renderView(view) {
      const main = document.getElementById('main-content');
      if (view === 'home') renderHome(main);
      else if (view === 'subscriptions') renderSubscriptions(main);
      else if (view === 'liked') renderLiked(main);
      else if (view === 'history') renderHistory(main);
      else if (view === 'watch') renderWatch(main);
      else if (view === 'channel') renderChannel(main);
    }

    // Home Feed View
    function renderHome(container) {
      let list = state.videos;
      if (state.searchQuery) {
        list = list.filter(v => v.title.toLowerCase().includes(state.searchQuery.toLowerCase()) || v.creatorName.toLowerCase().includes(state.searchQuery.toLowerCase()));
      }

      if (!list.length) {
        container.innerHTML = `
          <div class="flex flex-col items-center justify-center py-20 text-center">
            <div class="w-16 h-16 bg-gray-100 dark:bg-yt-darkCard rounded-full flex items-center justify-center text-gray-400 mb-3">
              <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"><path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/></svg>
            </div>
            <div class="text-base mb-1">No videos available</div>
            <p class="text-xs text-gray-500 dark:text-gray-400 max-w-sm mb-4">Be the first to upload and share videos on Fairtopia!</p>
            <button onclick="openUploadModal()" class="bg-yt-red text-white text-xs px-4 py-2 rounded-full hover:bg-red-700 transition">
              Upload Video
            </button>
          </div>
        `;
        return;
      }

      container.innerHTML = `
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          ${list.map(v => renderCard(v)).join('')}
        </div>
      `;
    }

    // Video Card Component
    function renderCard(v) {
      return `
        <div class="cursor-pointer group flex flex-col gap-2" onclick="watchVideo('${v.id}')">
          <div class="aspect-video w-full rounded-xl overflow-hidden bg-yt-darkCard relative border border-yt-lightBorder dark:border-yt-darkBorder">
            <img src="${v.thumbnail}" class="w-full h-full object-cover group-hover:scale-105 transition duration-200" alt="thumb" onerror="this.src='https://placehold.co/600x340/1f1f1f/ffffff?text=Video'">
          </div>
          <div class="flex gap-2.5 items-start">
            <img src="${v.creatorAvatar}" class="w-8 h-8 rounded-full object-cover mt-0.5" alt="avatar" onerror="this.src='https://placehold.co/100x100/1f1f1f/ffffff?text=C'">
            <div class="flex-1 min-w-0">
              <div class="text-xs leading-snug line-clamp-2 group-hover:text-blue-500">${escapeHtml(v.title)}</div>
              <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-1 hover:text-gray-800 dark:hover:text-white" onclick="event.stopPropagation(); viewChannel('${v.creatorId}')">
                ${escapeHtml(v.creatorName)}
              </p>
              <p class="text-[10px] text-gray-400">${v.views || 0} views • ${v.uploadedAt}</p>
            </div>
          </div>
        </div>
      `;
    }

    // Watch Video View
    function watchVideo(id) {
      const video = state.videos.find(v => v.id === id);
      if (!video) return;
      
      state.activeVideoId = id;
      video.views = (video.views || 0) + 1;
      
      if (!state.history.includes(id)) state.history.unshift(id);
      saveState();
      
      navigateTo('watch');
    }

    function renderWatch(container) {
      const video = state.videos.find(v => v.id === state.activeVideoId);
      if (!video) return;

      const isSubbed = state.subscriptions.includes(video.creatorId);
      const isLiked = state.likedVideos.includes(video.id);
      const comments = state.comments[video.id] || [];

      container.innerHTML = `
        <div class="flex flex-col lg:flex-row gap-6 max-w-6xl mx-auto">
          <!-- Main Player Column -->
          <div class="flex-1">
            <div class="aspect-video w-full bg-black rounded-2xl overflow-hidden border border-yt-lightBorder dark:border-yt-darkBorder">
              <video src="${video.videoUrl}" controls autoplay class="w-full h-full object-contain"></video>
            </div>

            <div class="text-base mt-3 mb-2">${escapeHtml(video.title)}</div>

            <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-yt-lightBorder dark:border-yt-darkBorder text-xs">
              <div class="flex items-center gap-3">
                <img src="${video.creatorAvatar}" onclick="viewChannel('${video.creatorId}')" class="w-9 h-9 rounded-full object-cover cursor-pointer" alt="avatar">
                <div>
                  <div onclick="viewChannel('${video.creatorId}')" class="cursor-pointer hover:underline">${escapeHtml(video.creatorName)}</div>
                  <p class="text-[10px] text-gray-400">${video.subscribers || 0} subscribers</p>
                </div>
                <button onclick="toggleSubscribe('${video.creatorId}')" class="ml-2 px-3 py-1.5 rounded-full ${isSubbed ? 'bg-gray-200 dark:bg-yt-darkHover text-gray-800 dark:text-white' : 'bg-yt-red text-white hover:bg-red-700'}">
                  ${isSubbed ? 'Subscribed' : 'Subscribe'}
                </button>
              </div>

              <div class="flex items-center gap-2">
                <button onclick="toggleLike('${video.id}')" class="flex items-center gap-1.5 bg-gray-100 dark:bg-yt-darkHover px-3 py-1.5 rounded-full ${isLiked ? 'text-emerald-500' : ''}">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M1 21h4V9H1v12zm22-11c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L14.17 1 7.58 7.59C7.22 7.95 7 8.45 7 9v10c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-2z"/></svg>
                  ${video.likes + (isLiked ? 1 : 0)}
                </button>
              </div>
            </div>

            <!-- Video Description Block -->
            <div class="bg-gray-100 dark:bg-yt-darkCard rounded-xl p-3 mt-3 text-xs space-y-1">
              <p class="text-gray-500 dark:text-gray-400">${video.views} views • Uploaded on ${video.uploadedAt}</p>
              <p class="whitespace-pre-line">${escapeHtml(video.description || 'No description provided.')}</p>
            </div>

            <!-- Comment Section -->
            <div class="mt-6">
              <div class="text-sm mb-3">Comments (${comments.length})</div>
              
              <div class="flex gap-2 mb-4">
                <input type="text" id="comment-input" placeholder="Add a comment..." class="flex-1 bg-transparent border-b border-yt-lightBorder dark:border-yt-darkBorder py-1 text-xs focus:outline-none focus:border-blue-500">
                <button onclick="addComment('${video.id}')" class="bg-blue-600 text-white px-3 py-1 rounded-full text-xs">Post</button>
              </div>

              <div class="space-y-3">
                ${comments.map(c => `
                  <div class="flex gap-2 text-xs">
                    <img src="${c.userAvatar}" class="w-6 h-6 rounded-full object-cover" alt="avatar">
                    <div>
                      <span class="mr-2">${escapeHtml(c.userName)}</span>
                      <span class="text-[10px] text-gray-400">${c.date}</span>
                      <p class="mt-0.5">${escapeHtml(c.text)}</p>
                    </div>
                  </div>
                `).join('')}
              </div>
            </div>
          </div>

          <!-- Up Next Sidebar Video List -->
          <div class="w-full lg:w-72 shrink-0 space-y-3">
            <div class="text-xs">Up Next</div>
            ${state.videos.filter(v => v.id !== video.id).map(v => `
              <div onclick="watchVideo('${v.id}')" class="flex gap-2 cursor-pointer group">
                <div class="w-28 aspect-video rounded-lg overflow-hidden bg-yt-darkCard shrink-0">
                  <img src="${v.thumbnail}" class="w-full h-full object-cover group-hover:scale-105 transition" alt="thumb">
                </div>
                <div class="flex-1 min-w-0">
                  <div class="text-xs line-clamp-2 leading-tight group-hover:text-blue-500">${escapeHtml(v.title)}</div>
                  <p class="text-[10px] text-gray-400 mt-1">${escapeHtml(v.creatorName)}</p>
                </div>
              </div>
            `).join('')}
          </div>
        </div>
      `;
    }

    // Channel Details View
    function viewMyChannel() {
      if (!state.currentUser) {
        openAuthModal();
        return;
      }
      viewChannel(state.currentUser.id);
    }

    function viewChannel(creatorId) {
      state.activeChannelId = creatorId;
      navigateTo('channel');
    }

    function renderChannel(container) {
      const isMyChannel = state.currentUser && state.activeChannelId === state.currentUser.id;
      
      let profile = isMyChannel ? state.currentUser : null;
      if (!profile) {
        const video = state.videos.find(v => v.creatorId === state.activeChannelId);
        profile = {
          id: state.activeChannelId,
          name: video ? video.creatorName : 'Creator Channel',
          handle: '@creator',
          avatar: video ? video.creatorAvatar : 'https://placehold.co/100x100/1f1f1f/ffffff?text=C',
          banner: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=1200',
          subscribers: 0,
          bio: 'Creator profile on Fairtopia.'
        };
      }

      const myVideos = state.videos.filter(v => v.creatorId === profile.id);

      container.innerHTML = `
        <div class="max-w-5xl mx-auto space-y-4">
          <!-- Channel Banner -->
          <div class="h-32 md:h-44 rounded-2xl overflow-hidden bg-yt-darkCard border border-yt-lightBorder dark:border-yt-darkBorder">
            <img src="${profile.banner || 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=1200'}" class="w-full h-full object-cover" alt="banner">
          </div>

          <!-- Channel Info -->
          <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4 px-2">
            <img src="${profile.avatar}" class="w-20 h-20 rounded-full object-cover border-2 border-white dark:border-yt-darkBg shadow-md" alt="avatar">
            <div class="flex-1 text-center sm:text-left space-y-1">
              <div class="text-xl">${escapeHtml(profile.name)}</div>
              <p class="text-xs text-gray-500 dark:text-gray-400">${escapeHtml(profile.handle)} • ${profile.subscribers || 0} subscribers • ${myVideos.length} videos</p>
              <p class="text-xs text-gray-600 dark:text-gray-300">${escapeHtml(profile.bio || '')}</p>
            </div>
            <div>
              ${isMyChannel ? `
                <button onclick="openEditChannelModal()" class="bg-gray-100 dark:bg-yt-darkHover border border-yt-lightBorder dark:border-yt-darkBorder px-4 py-1.5 rounded-full text-xs hover:bg-gray-200 dark:hover:bg-yt-darkBorder">
                  Customize Channel
                </button>
              ` : ''}
            </div>
          </div>

          <hr class="border-yt-lightBorder dark:border-yt-darkBorder">

          <!-- Channel Videos -->
          <div>
            <div class="text-sm mb-3">Published Videos</div>
            ${myVideos.length ? `
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                ${myVideos.map(v => renderCard(v)).join('')}
              </div>
            ` : `
              <div class="py-12 text-center text-xs text-gray-500">No videos uploaded to this channel yet.</div>
            `}
          </div>
        </div>
      `;
    }

    // Auth Simulation
    function openAuthModal() { document.getElementById('auth-modal').classList.remove('hidden'); }
    function closeAuthModal() { document.getElementById('auth-modal').classList.add('hidden'); }

    function signInWithGoogle() {
      state.currentUser = {
        id: 'usr_' + Date.now(),
        name: 'Alex Creator',
        handle: '@alexcreator',
        avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150',
        banner: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=1200',
        subscribers: 0,
        bio: 'Welcome to my official video channel on Fairtopia!'
      };
      saveState();
      renderUserArea();
      closeAuthModal();
      viewMyChannel();
    }

    function logout() {
      state.currentUser = null;
      localStorage.removeItem('ft_user');
      renderUserArea();
      navigateTo('home');
    }

    // Video Upload Handlers
    function openUploadModal() {
      if (!state.currentUser) return openAuthModal();
      document.getElementById('upload-modal').classList.remove('hidden');
    }
    function closeUploadModal() {
      document.getElementById('upload-modal').classList.add('hidden');
      selectedFileDataUrl = null;
      document.getElementById('file-selected-label').innerText = '';
    }

    function handleFileSelect(input) {
      const file = input.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        selectedFileDataUrl = e.target.result;
        document.getElementById('file-selected-label').innerText = 'Selected File: ' + file.name;
      };
      reader.readAsDataURL(file);
    }

    function handleVideoUpload(e) {
      e.preventDefault();
      const title = document.getElementById('upload-title').value.trim();
      const desc = document.getElementById('upload-desc').value.trim();
      const urlInput = document.getElementById('upload-url').value.trim();
      const thumbInput = document.getElementById('upload-thumb').value.trim();

      const finalVideoUrl = selectedFileDataUrl || urlInput || 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4';
      const finalThumbUrl = thumbInput || 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=600';

      const now = new Date();
      const formattedDate = now.toLocaleDateString() + ' ' + now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

      const newVid = {
        id: 'v_' + Date.now(),
        title,
        description: desc,
        videoUrl: finalVideoUrl,
        thumbnail: finalThumbUrl,
        views: 1,
        likes: 0,
        uploadedAt: formattedDate,
        creatorId: state.currentUser.id,
        creatorName: state.currentUser.name,
        creatorAvatar: state.currentUser.avatar,
        subscribers: state.currentUser.subscribers
      };

      state.videos.unshift(newVid);
      saveState();
      closeUploadModal();
      watchVideo(newVid.id);
    }

    // Edit Channel Handlers
    function openEditChannelModal() {
      document.getElementById('edit-name').value = state.currentUser.name;
      document.getElementById('edit-handle').value = state.currentUser.handle;
      document.getElementById('edit-avatar').value = state.currentUser.avatar;
      document.getElementById('edit-banner').value = state.currentUser.banner;
      document.getElementById('edit-bio').value = state.currentUser.bio || '';
      document.getElementById('edit-channel-modal').classList.remove('hidden');
    }
    function closeEditChannelModal() {
      document.getElementById('edit-channel-modal').classList.add('hidden');
    }
    function saveChannelEdit(e) {
      e.preventDefault();
      state.currentUser.name = document.getElementById('edit-name').value;
      state.currentUser.handle = document.getElementById('edit-handle').value;
      state.currentUser.avatar = document.getElementById('edit-avatar').value;
      state.currentUser.banner = document.getElementById('edit-banner').value;
      state.currentUser.bio = document.getElementById('edit-bio').value;
      saveState();
      renderUserArea();
      closeEditChannelModal();
      renderChannel(document.getElementById('main-content'));
    }

    // Additional Actions
    function toggleLike(id) {
      const idx = state.likedVideos.indexOf(id);
      if (idx > -1) state.likedVideos.splice(idx, 1);
      else state.likedVideos.push(id);
      saveState();
      renderWatch(document.getElementById('main-content'));
    }

    function toggleSubscribe(creatorId) {
      const idx = state.subscriptions.indexOf(creatorId);
      if (idx > -1) state.subscriptions.splice(idx, 1);
      else state.subscriptions.push(creatorId);
      saveState();
      if (state.currentView === 'watch') renderWatch(document.getElementById('main-content'));
      else if (state.currentView === 'channel') renderChannel(document.getElementById('main-content'));
    }

    function addComment(videoId) {
      const input = document.getElementById('comment-input');
      const text = input.value.trim();
      if (!text) return;
      if (!state.currentUser) return openAuthModal();

      const now = new Date();
      const timeStr = now.toLocaleDateString() + ' ' + now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

      if (!state.comments[videoId]) state.comments[videoId] = [];
      state.comments[videoId].unshift({
        userName: state.currentUser.name,
        userAvatar: state.currentUser.avatar,
        text,
        date: timeStr
      });
      saveState();
      renderWatch(document.getElementById('main-content'));
    }

    function renderSubscriptions(container) {
      const subs = state.videos.filter(v => state.subscriptions.includes(v.creatorId));
      container.innerHTML = `<div class="text-sm mb-4">Subscriptions</div>` + 
        (subs.length ? `<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">${subs.map(v => renderCard(v)).join('')}</div>` : `<p class="text-xs text-gray-500">No videos from subscribed channels yet.</p>`);
    }

    function renderLiked(container) {
      const liked = state.videos.filter(v => state.likedVideos.includes(v.id));
      container.innerHTML = `<div class="text-sm mb-4">Liked Videos</div>` + 
        (liked.length ? `<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">${liked.map(v => renderCard(v)).join('')}</div>` : `<p class="text-xs text-gray-500">No liked videos yet.</p>`);
    }

    function renderHistory(container) {
      const hist = state.history.map(id => state.videos.find(v => v.id === id)).filter(Boolean);
      container.innerHTML = `<div class="text-sm mb-4">Watch History</div>` + 
        (hist.length ? `<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">${hist.map(v => renderCard(v)).join('')}</div>` : `<p class="text-xs text-gray-500">History is empty.</p>`);
    }

    function handleSearch(e) {
      e.preventDefault();
      state.searchQuery = document.getElementById('search-input').value.trim();
      navigateTo('home');
    }

    function escapeHtml(str) {
      if (!str) return '';
      return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }
  </script>
</body>
</html>
