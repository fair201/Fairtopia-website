                banner: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1200&q=80',
                subscribers: '12',
                bio: 'Digital content creator on Fairtopia.'
            };
            saveData();
            renderHeaderAuth();
            closeModal('auth-modal');
        }

        function handleAuthSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('auth-name').value;
            const email = document.getElementById('auth-email').value;
            let handle = document.getElementById('auth-handle').value;
            if (!handle.startsWith('@')) handle = '@' + handle;

            state.user = {
                name,
                email,
                handle,
                avatar: 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=200&q=80',
                banner: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1200&q=80',
                subscribers: '0',
                bio: 'New Fairtopia channel creator.'
            };
            saveData();
            renderHeaderAuth();
            closeModal('auth-modal');
        }

        function logout() {
            state.user = null;
            saveData();
            renderHeaderAuth();
            navigateTo('home');
        }

        function openOwnChannel() {
            if (!state.user) {
                openModal('auth-modal');
            } else {
                navigateTo('channel', { handle: state.user.handle });
            }
        }

        /* UPLOAD HANDLING */
        function openUploadModal() {
            if (!state.user) {
                openModal('auth-modal');
                return;
            }
            openModal('upload-modal');
        }

        function toggleUploadInputs() {
            const type = document.getElementById('upload-type').value;
            document.getElementById('upload-url-container').style.display = type === 'url' ? 'block' : 'none';
            document.getElementById('upload-file-container').style.display = type === 'file' ? 'block' : 'none';
        }

        function handleUploadSubmit(e) {
            e.preventDefault();
            const title = document.getElementById('upload-title').value;
            const type = document.getElementById('upload-type').value;
            const customThumb = document.getElementById('upload-thumb').value;
            const desc = document.getElementById('upload-desc').value;

            let videoUrl = 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4';
            if (type === 'url' && document.getElementById('upload-url').value) {
                videoUrl = document.getElementById('upload-url').value;
            }

            // Create timestamp recording exact date uploaded
            const now = new Date();
            const options = { month: 'short', day: 'numeric', year: 'numeric' };
            const uploadDate = now.toLocaleDateString('en-US', options); // e.g. "Oct 24, 2026"

            const newVideo = {
                id: 'ft-' + Date.now(),
                title: title,
                uploaderName: state.user.name,
                uploaderHandle: state.user.handle,
                uploaderAvatar: state.user.avatar,
                bannerUrl: state.user.banner,
                views: '1',
                timestamp: uploadDate,
                duration: '03:15',
                thumbnail: customThumb || 'https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=800&q=80',
                videoUrl: videoUrl,
                description: desc || 'No description provided.',
                subscribers: state.user.subscribers || '1',
                likes: 1,
                dislikes: 0,
                comments: []
            };

            state.videos.unshift(newVideo);
            saveData();
            closeModal('upload-modal');
            navigateTo('watch', { id: newVideo.id });
        }

        /* CHANNEL EDIT CUSTOMIZATION */
        function openEditChannelModal() {
            if (!state.user) return;
            document.getElementById('edit-name').value = state.user.name;
            document.getElementById('edit-handle').value = state.user.handle;
            document.getElementById('edit-avatar').value = state.user.avatar;
            document.getElementById('edit-banner').value = state.user.banner;
            document.getElementById('edit-bio').value = state.user.bio || '';
            openModal('edit-channel-modal');
        }

        function handleChannelUpdate(e) {
            e.preventDefault();
            const name = document.getElementById('edit-name').value;
            const handle = document.getElementById('edit-handle').value;
            const avatar = document.getElementById('edit-avatar').value;
            const banner = document.getElementById('edit-banner').value;
            const bio = document.getElementById('edit-bio').value;

            state.user.name = name;
            state.user.handle = handle;
            state.user.avatar = avatar;
            state.user.banner = banner;
            state.user.bio = bio;

            // Sync user uploads
            state.videos.forEach(v => {
                if (v.uploaderHandle === state.user.handle) {
                    v.uploaderName = name;
                    v.uploaderAvatar = avatar;
                    v.bannerUrl = banner;
                }
            });

            saveData();
            closeModal('edit-channel-modal');
            renderChannelPage(state.user.handle);
        }

        /* ACTIONS: SUBSCRIBE, SEARCH, HISTORY, SUBTITLES */
        function toggleSubscribe(handle) {
            if (!state.user) {
                openModal('auth-modal');
                return;
            }
            const index = state.subscriptions.indexOf(handle);
            if (index > -1) {
                state.subscriptions.splice(index, 1);
            } else {
                state.subscriptions.push(handle);
            }
            saveData();
            renderSidebarSubscriptions();
            
            if (state.currentView === 'watch') {
                renderWatchPage(state.activeVideoId);
            } else if (state.currentView === 'channel') {
                renderChannelPage(handle);
            }
        }

        function executeSearch() {
            const query = document.getElementById('search-input').value.toLowerCase().trim();
            if (!query) {
                renderHomeGrid();
                return;
            }
            const filtered = state.videos.filter(v => 
                v.title.toLowerCase().includes(query) || 
                v.uploaderName.toLowerCase().includes(query)
            );
            state.currentView = 'home';
            renderHomeGrid(filtered);
        }

        function addToHistory(id) {
            if (!state.history.includes(id)) {
                state.history.unshift(id);
                saveData();
            }
        }

        function likeVideo(id) {
            const v = state.videos.find(item => item.id === id);
            if (v) {
                v.likes++;
                saveData();
                renderWatchPage(id);
            }
        }

        function dislikeVideo(id) {
            const v = state.videos.find(item => item.id === id);
            if (v) {
                v.dislikes++;
                saveData();
                renderWatchPage(id);
            }
        }

        function addComment(id) {
            const input = document.getElementById('comment-input');
            if (!input || !input.value.trim()) return;

            const v = state.videos.find(item => item.id === id);
            if (v) {
                v.comments.unshift({
                    user: state.user ? state.user.name : 'Guest User',
                    text: input.value.trim(),
                    date: 'Just now'
                });
                saveData();
                renderWatchPage(id);
            }
        }

        function shareVideo(title) {
            navigator.clipboard.writeText(window.location.href);
            alert('Video link copied to clipboard!');
        }

        /* SUBTITLE TESTER HANDLERS */
        function updateSubtitleText(val) {
            state.subtitleText = val;
            const el = document.getElementById('subtitle-text');
            if (el) el.innerText = val;
        }

        function updateSubtitleColor(val) {
            state.subtitleColor = val;
            const el = document.getElementById('subtitle-text');
            if (el) el.style.color = val;
        }

        function toggleSubtitles() {
            state.subtitlesEnabled = !state.subtitlesEnabled;
            const el = document.getElementById('subtitle-text');
            if (el) el.style.display = state.subtitlesEnabled ? 'inline-block' : 'none';
        }

        /* THEMES & FRAME TOGGLE */
        function setTheme(themeName) {
            state.currentTheme = themeName;
            document.documentElement.setAttribute('data-theme', themeName);
            saveData();
            const menu = document.getElementById('theme-menu');
            if (menu) menu.classList.add('hidden');
        }

        function toggleThemeMenu() {
            const menu = document.getElementById('theme-menu');
            menu.classList.toggle('hidden');
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('main-sidebar');
            state.sidebarCollapsed = !state.sidebarCollapsed;
            if (state.sidebarCollapsed) {
                sidebar.classList.add('w-16');
                sidebar.classList.remove('w-60');
                document.querySelectorAll('.sidebar-label').forEach(el => el.classList.add('hidden'));
            } else {
                sidebar.classList.remove('w-16');
                sidebar.classList.add('w-60');
                document.querySelectorAll('.sidebar-label').forEach(el => el.classList.remove('hidden'));
            }
        }

        function toggleDeviceFrame() {
            const container = document.getElementById('app-viewport-container');
            const btn = document.getElementById('toggle-frame-btn');
            state.isDeviceFrame = !state.isDeviceFrame;

            if (state.isDeviceFrame) {
                container.classList.add('device-ios');
                btn.innerHTML = `<i class="fa-solid fa-desktop mr-1"></i> Mode: iOS`;
            } else {
                container.classList.remove('device-ios');
                btn.innerHTML = `<i class="fa-solid fa-mobile-screen mr-1"></i> Mode: Desktop`;
            }
        }

        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }
    </script>
</body>
</html>
