<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fairtopia - Video Sharing & Social Hub</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Orbitron:wght@500;700&family=Fredoka:wght@400;600&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        yt: {
                            red: '#FF0000',
                            darkBg: '#0f0f0f',
                            darkNav: '#0f0f0f',
                            darkCard: '#181818',
                            darkHover: '#272727',
                            darkBorder: '#3f3f3f',
                            lightBg: '#f1f1f1',
                            lightNav: '#ffffff',
                            lightCard: '#ffffff',
                            lightHover: '#e5e5e5',
                            lightBorder: '#e0e0e0'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Base styles & Smooth transitions */
        body {
            font-family: 'Roboto', sans-serif;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        /* Line clamp for 2-line title limit */
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Custom Scrollbars */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(150, 150, 150, 0.4);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(150, 150, 150, 0.6);
        }

        /* Theme Styling Overrides */
        /* 1. YouTube Dark (Default) */
        [data-theme="dark"] {
            background-color: #0f0f0f;
            color: #f1f1f1;
        }
        [data-theme="dark"] .bg-surface { background-color: #0f0f0f; }
        [data-theme="dark"] .bg-card { background-color: #181818; }
        [data-theme="dark"] .bg-hover:hover { background-color: #272727; }
        [data-theme="dark"] .border-theme { border-color: #272727; }
        [data-theme="dark"] .text-sub { color: #aaaaaa; }

        /* 2. YouTube Light */
        [data-theme="light"] {
            background-color: #f9f9f9;
            color: #0f0f0f;
        }
        [data-theme="light"] .bg-surface { background-color: #ffffff; }
        [data-theme="light"] .bg-card { background-color: #ffffff; }
        [data-theme="light"] .bg-hover:hover { background-color: #e5e5e5; }
        [data-theme="light"] .border-theme { border-color: #e5e5e5; }
        [data-theme="light"] .text-sub { color: #606060; }

        /* 3. Frutiger Aero Theme */
        [data-theme="aero"] {
            background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);
            color: #012a4a;
            font-family: 'Fredoka', sans-serif;
        }
        [data-theme="aero"] .bg-surface {
            background: rgba(255, 255, 255, 0.65);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.15);
        }
        [data-theme="aero"] .bg-card {
            background: rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 4px 15px rgba(0, 150, 255, 0.15);
            border-radius: 16px;
        }
        [data-theme="aero"] .bg-hover:hover { background-color: rgba(255, 255, 255, 0.95); }
        [data-theme="aero"] .border-theme { border-color: rgba(255, 255, 255, 0.5); }
        [data-theme="aero"] .text-sub { color: #2c6e91; }

        /* 4. Cyberpunk Theme */
        [data-theme="cyberpunk"] {
            background-color: #05050a;
            color: #00ffcc;
            font-family: 'Orbitron', sans-serif;
        }
        [data-theme="cyberpunk"] .bg-surface {
            background-color: #0a0a16;
            border-bottom: 2px solid #ff0055;
            box-shadow: 0 0 15px rgba(255, 0, 85, 0.3);
        }
        [data-theme="cyberpunk"] .bg-card {
            background-color: #121225;
            border: 1px solid #00ffcc;
            box-shadow: 0 0 8px rgba(0, 255, 204, 0.2);
            border-radius: 4px;
        }
        [data-theme="cyberpunk"] .bg-hover:hover {
            background-color: #ff0055;
            color: #ffffff;
        }
        [data-theme="cyberpunk"] .border-theme { border-color: #00ffcc; }
        [data-theme="cyberpunk"] .text-sub { color: #ff007f; }

        /* Mobile Viewport Simulation Framing */
        .device-ios {
            max-width: 430px;
            margin: 20px auto;
            border: 12px solid #222;
            border-radius: 48px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            overflow: hidden;
            height: 880px;
        }
    </style>
</head>
<body class="flex flex-col h-screen overflow-hidden text-sm">

    <!-- BROWSER SIMULATOR TOP BAR -->
    <div id="browser-bar" class="bg-gray-900 text-gray-300 px-4 py-1.5 flex items-center justify-between text-xs border-b border-gray-800 z-50 shrink-0 select-none">
        <div class="flex items-center gap-2">
            <span class="inline-block w-3 h-3 rounded-full bg-red-500 cursor-pointer" title="Close"></span>
            <span class="inline-block w-3 h-3 rounded-full bg-yellow-500 cursor-pointer" title="Minimize"></span>
            <span class="inline-block w-3 h-3 rounded-full bg-green-500 cursor-pointer" title="Maximize"></span>
            <div class="flex items-center gap-2 ml-4 text-gray-400">
                <i class="fa-solid fa-chevron-left cursor-pointer hover:text-white" onclick="history.back()"></i>
                <i class="fa-solid fa-chevron-right cursor-pointer hover:text-white" onclick="history.forward()"></i>
                <i class="fa-solid fa-rotate-right cursor-pointer hover:text-white" onclick="location.reload()"></i>
            </div>
        </div>
        <div class="flex-1 max-w-xl mx-4">
            <div class="bg-gray-800 text-gray-200 px-3 py-1 rounded-full flex items-center gap-2 text-xs border border-gray-700 focus-within:border-blue-500">
                <i class="fa-solid fa-lock text-green-400 text-px"></i>
                <span id="simulator-url" class="truncate w-full select-all font-mono">https://fairtopia.com/watch?v=ft-001</span>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <button id="toggle-frame-btn" onclick="toggleDeviceFrame()" class="bg-gray-800 hover:bg-gray-700 px-2.5 py-1 rounded border border-gray-700 text-gray-200 transition">
                <i class="fa-solid fa-mobile-screen mr-1"></i> Mode: Desktop
            </button>
        </div>
    </div>

    <!-- MAIN WRAPPER FRAME -->
    <div id="app-viewport-container" class="flex-1 flex flex-col min-h-0 relative overflow-hidden transition-all duration-300">
        
        <!-- YOUTUBE HEADER NAVBAR -->
        <header class="bg-surface border-b border-theme h-14 px-4 flex items-center justify-between z-40 shrink-0 select-none">
            <!-- Left Header: Burger & Logo -->
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" class="p-2 rounded-full bg-hover text-lg focus:outline-none">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div onclick="navigateTo('home')" class="flex items-center gap-1.5 cursor-pointer">
                    <div class="bg-red-600 text-white rounded-xl px-2 py-0.5 font-black tracking-tighter text-base flex items-center gap-1 shadow-sm">
                        <i class="fa-solid fa-play text-xs"></i>
                    </div>
                    <span class="font-bold text-lg tracking-tight font-sans">Fairtopia<span class="text-xs text-red-500 font-normal ml-0.5">TH</span></span>
                </div>
            </div>

            <!-- Center Header: YouTube Pill Search Bar -->
            <div class="flex-1 max-w-2xl mx-4 hidden md:flex items-center justify-center">
                <div class="flex w-full max-w-lg items-center">
                    <div class="flex flex-1 items-center bg-transparent border border-gray-300 dark:border-gray-700 rounded-l-full px-4 py-1.5 focus-within:border-blue-500">
                        <i class="fa-solid fa-magnifying-glass text-sub mr-2"></i>
                        <input id="search-input" type="text" placeholder="Search Fairtopia videos, channels..." onkeyup="if(event.key==='Enter') executeSearch()" class="w-full bg-transparent focus:outline-none text-sm">
                    </div>
                    <button onclick="executeSearch()" class="bg-gray-100 dark:bg-zinc-800 border border-l-0 border-gray-300 dark:border-gray-700 rounded-r-full px-5 py-2 hover:bg-gray-200 dark:hover:bg-zinc-700 transition">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </div>

            <!-- Right Header: User Actions & Auth -->
            <div class="flex items-center gap-2 md:gap-3">
                <button onclick="openUploadModal()" class="flex items-center gap-2 bg-hover px-3 py-1.5 rounded-full font-medium text-xs md:text-sm">
                    <i class="fa-solid fa-plus text-base"></i>
                    <span class="hidden sm:inline">Create</span>
                </button>

                <!-- Theme Engine Dropdown -->
                <div class="relative">
                    <button onclick="toggleThemeMenu()" class="p-2 rounded-full bg-hover text-base">
                        <i class="fa-solid fa-palette"></i>
                    </button>
                    <div id="theme-menu" class="hidden absolute right-0 mt-2 w-48 bg-card rounded-xl shadow-2xl border border-theme py-2 z-50 text-xs">
                        <div class="px-3 py-1 font-bold text-sub uppercase tracking-wider text-[10px]">Select Theme</div>
                        <button onclick="setTheme('dark')" class="w-full px-4 py-2 text-left bg-hover flex items-center justify-between">
                            <span><i class="fa-solid fa-moon mr-2"></i> YouTube Dark</span>
                        </button>
                        <button onclick="setTheme('light')" class="w-full px-4 py-2 text-left bg-hover flex items-center justify-between">
                            <span><i class="fa-solid fa-sun mr-2"></i> YouTube Light</span>
                        </button>
                        <button onclick="setTheme('aero')" class="w-full px-4 py-2 text-left bg-hover flex items-center justify-between">
                            <span><i class="fa-solid fa-water mr-2"></i> Frutiger Aero</span>
                        </button>
                        <button onclick="setTheme('cyberpunk')" class="w-full px-4 py-2 text-left bg-hover flex items-center justify-between">
                            <span><i class="fa-solid fa-bolt mr-2"></i> Cyberpunk</span>
                        </button>
                    </div>
                </div>

                <!-- User Profile / Auth Button -->
                <div id="auth-header-area">
                    <!-- Populated dynamically by JS -->
                </div>
            </div>
        </header>

        <!-- MAIN CONTENT CONTAINER WITH SIDEBAR -->
        <div class="flex flex-1 min-h-0 overflow-hidden">
            
            <!-- YOUTUBE SIDEBAR NAVIGATION -->
            <aside id="main-sidebar" class="w-60 bg-surface border-r border-theme flex flex-col shrink-0 transition-all duration-300 overflow-y-auto select-none z-30">
                <div class="p-2 space-y-1">
                    <button onclick="navigateTo('home')" class="w-full flex items-center gap-5 px-3 py-2.5 rounded-xl bg-hover font-medium text-left">
                        <i class="fa-solid fa-house text-lg w-6 text-center"></i>
                        <span class="sidebar-label">Home</span>
                    </button>
                    <button onclick="navigateTo('subscriptions')" class="w-full flex items-center gap-5 px-3 py-2.5 rounded-xl bg-hover font-medium text-left">
                        <i class="fa-solid fa-photo-film text-lg w-6 text-center"></i>
                        <span class="sidebar-label">Subscriptions</span>
                    </button>
                    <button onclick="navigateTo('history')" class="w-full flex items-center gap-5 px-3 py-2.5 rounded-xl bg-hover font-medium text-left">
                        <i class="fa-solid fa-clock-rotate-left text-lg w-6 text-center"></i>
                        <span class="sidebar-label">History</span>
                    </button>
                </div>

                <hr class="border-theme my-2">

                <div class="p-2 space-y-1">
                    <div class="px-3 py-1 font-semibold text-xs text-sub uppercase sidebar-label">You</div>
                    <button onclick="openOwnChannel()" class="w-full flex items-center gap-5 px-3 py-2.5 rounded-xl bg-hover font-medium text-left">
                        <i class="fa-regular fa-user text-lg w-6 text-center"></i>
                        <span class="sidebar-label">Your Channel</span>
                    </button>
                    <button onclick="navigateTo('groups')" class="w-full flex items-center gap-5 px-3 py-2.5 rounded-xl bg-hover font-medium text-left">
                        <i class="fa-solid fa-users text-lg w-6 text-center"></i>
                        <span class="sidebar-label">Groups & Social</span>
                    </button>
                </div>

                <hr class="border-theme my-2">

                <!-- Subscriptions List Section -->
                <div class="p-2 space-y-1 flex-1">
                    <div class="px-3 py-1 font-semibold text-xs text-sub uppercase sidebar-label">Subscriptions</div>
                    <div id="sidebar-subscriptions-list" class="space-y-1">
                        <!-- Dynamic content -->
                    </div>
                </div>

                <div class="p-3 text-xs text-sub text-center border-t border-theme sidebar-label">
                    Fairtopia Hub &copy; 2026<br>YouTube Authentic UI
                </div>
            </aside>

            <!-- MAIN VIEW CONTAINER (HOME, WATCH, CHANNEL, ETC.) -->
            <main id="main-content" class="flex-1 overflow-y-auto p-4 md:p-6 bg-surface">
                <!-- Page content dynamically rendered by JavaScript -->
            </main>

        </div>
    </div>

    <!-- MODAL: SIGN IN / AUTH -->
    <div id="auth-modal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-card border border-theme rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
            <button onclick="closeModal('auth-modal')" class="absolute top-4 right-4 text-sub hover:text-white">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
            <div class="text-center mb-6">
                <div class="inline-flex bg-red-600 text-white rounded-2xl p-3 mb-2">
                    <i class="fa-solid fa-play text-2xl"></i>
                </div>
                <h2 class="text-xl font-bold">Sign in to Fairtopia</h2>
                <p class="text-xs text-sub mt-1">Unlock uploads, subscriptions, and channel customization</p>
            </div>

            <!-- Simulated Google Login -->
            <button onclick="simulateGoogleLogin()" class="w-full bg-white text-gray-800 font-medium py-2.5 px-4 rounded-full border border-gray-300 flex items-center justify-center gap-3 hover:bg-gray-100 transition shadow-sm mb-4">
                <svg class="w-5 h-5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
                Continue with Google
            </button>

            <div class="relative flex py-2 items-center">
                <div class="flex-grow border-t border-theme"></div>
                <span class="flex-shrink mx-3 text-sub text-xs">or custom details</span>
                <div class="flex-grow border-t border-theme"></div>
            </div>

            <form onsubmit="handleAuthSubmit(event)" class="space-y-3 mt-3">
                <div>
                    <label class="text-xs font-semibold text-sub">Channel Name</label>
                    <input id="auth-name" type="text" required placeholder="e.g. Alex Creator" class="w-full mt-1 bg-surface border border-theme rounded-xl px-3 py-2 text-sm focus:outline-none">
                </div>
                <div>
                    <label class="text-xs font-semibold text-sub">Email</label>
                    <input id="auth-email" type="email" required placeholder="alex@fairtopia.com" class="w-full mt-1 bg-surface border border-theme rounded-xl px-3 py-2 text-sm focus:outline-none">
                </div>
                <div>
                    <label class="text-xs font-semibold text-sub">Handle</label>
                    <input id="auth-handle" type="text" required placeholder="@alexcreator" class="w-full mt-1 bg-surface border border-theme rounded-xl px-3 py-2 text-sm focus:outline-none">
                </div>
                <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-medium py-2.5 rounded-full transition mt-2">
                    Sign In / Register
                </button>
            </form>
        </div>
    </div>

    <!-- MODAL: UPLOAD VIDEO / CONTENT -->
    <div id="upload-modal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-card border border-theme rounded-2xl max-w-lg w-full p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
            <button onclick="closeModal('upload-modal')" class="absolute top-4 right-4 text-sub hover:text-white">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
            <h2 class="text-lg font-bold mb-4 flex items-center gap-2">
                <i class="fa-solid fa-upload text-red-600"></i> Upload Content
            </h2>
            <form onsubmit="handleUploadSubmit(event)" class="space-y-4">
                <div>
                    <label class="text-xs font-semibold text-sub">Title</label>
                    <input id="upload-title" type="text" required placeholder="Give your video a catchy title" class="w-full mt-1 bg-surface border border-theme rounded-xl px-3 py-2 text-sm focus:outline-none">
                </div>
                <div>
                    <label class="text-xs font-semibold text-sub">Media Source</label>
                    <select id="upload-type" onchange="toggleUploadInputs()" class="w-full mt-1 bg-surface border border-theme rounded-xl px-3 py-2 text-sm focus:outline-none">
                        <option value="url">Video URL (MP4 / WebM)</option>
                        <option value="file">Upload Local File</option>
                        <option value="sample">Use High Quality Sample Video</option>
                    </select>
                </div>
                <div id="upload-url-container">
                    <label class="text-xs font-semibold text-sub">Video URL</label>
                    <input id="upload-url" type="url" placeholder="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4" class="w-full mt-1 bg-surface border border-theme rounded-xl px-3 py-2 text-sm focus:outline-none">
                </div>
                <div id="upload-file-container" class="hidden">
                    <label class="text-xs font-semibold text-sub">Select Video File</label>
                    <input id="upload-file" type="file" accept="video/*" class="w-full mt-1 text-xs text-sub">
                </div>
                <div>
                    <label class="text-xs font-semibold text-sub">Thumbnail URL (Optional)</label>
                    <input id="upload-thumb" type="url" placeholder="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe" class="w-full mt-1 bg-surface border border-theme rounded-xl px-3 py-2 text-sm focus:outline-none">
                </div>
                <div>
                    <label class="text-xs font-semibold text-sub">Description</label>
                    <textarea id="upload-desc" rows="3" placeholder="Tell viewers about your video..." class="w-full mt-1 bg-surface border border-theme rounded-xl px-3 py-2 text-sm focus:outline-none"></textarea>
                </div>
                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" onclick="closeModal('upload-modal')" class="px-4 py-2 rounded-full bg-hover text-xs font-medium">Cancel</button>
                    <button type="submit" class="px-6 py-2 rounded-full bg-red-600 hover:bg-red-700 text-white text-xs font-medium transition">Publish Video</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: EDIT CHANNEL / PROFILE -->
    <div id="edit-channel-modal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-card border border-theme rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
            <button onclick="closeModal('edit-channel-modal')" class="absolute top-4 right-4 text-sub hover:text-white">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
            <h2 class="text-lg font-bold mb-4">Customize Channel</h2>
            <form onsubmit="handleChannelUpdate(event)" class="space-y-3">
                <div>
                    <label class="text-xs font-semibold text-sub">Channel Name</label>
                    <input id="edit-name" type="text" required class="w-full mt-1 bg-surface border border-theme rounded-xl px-3 py-2 text-sm focus:outline-none">
                </div>
                <div>
                    <label class="text-xs font-semibold text-sub">Handle</label>
                    <input id="edit-handle" type="text" required class="w-full mt-1 bg-surface border border-theme rounded-xl px-3 py-2 text-sm focus:outline-none">
                </div>
                <div>
                    <label class="text-xs font-semibold text-sub">Profile Avatar Image URL</label>
                    <input id="edit-avatar" type="url" class="w-full mt-1 bg-surface border border-theme rounded-xl px-3 py-2 text-sm focus:outline-none">
                </div>
                <div>
                    <label class="text-xs font-semibold text-sub">Header Banner Image URL</label>
                    <input id="edit-banner" type="url" class="w-full mt-1 bg-surface border border-theme rounded-xl px-3 py-2 text-sm focus:outline-none">
                </div>
                <div>
                    <label class="text-xs font-semibold text-sub">Channel Bio</label>
                    <textarea id="edit-bio" rows="2" class="w-full mt-1 bg-surface border border-theme rounded-xl px-3 py-2 text-sm focus:outline-none"></textarea>
                </div>
                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" onclick="closeModal('edit-channel-modal')" class="px-4 py-2 rounded-full bg-hover text-xs font-medium">Cancel</button>
                    <button type="submit" class="px-5 py-2 rounded-full bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium transition">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MAIN JAVASCRIPT APP LOGIC -->
    <script>
        // State Management
        let currentUser = null;
        let activeTab = 'home';
        let currentTheme = 'dark';
        let currentViewport = 'desktop';
        let isEditingProfile = false;
        let activeChannelTab = 'home';

        // Initial Empty Videos Array (Removed pre-loaded sample videos)
        const initialVideos = [];

        // App Data State loaded from localStorage or initialized empty
        let appData = {
            videos: JSON.parse(localStorage.getItem('fairtopia_videos')) || initialVideos,
            users: JSON.parse(localStorage.getItem('fairtopia_users')) || {},
            subscriptions: JSON.parse(localStorage.getItem('fairtopia_subscriptions')) || [],
            likedVideos: JSON.parse(localStorage.getItem('fairtopia_likes')) || []
        };

        // Initialize App
        window.addEventListener('DOMContentLoaded', () => {
            setTheme(state.currentTheme);
            renderHeaderAuth();
            renderSidebarSubscriptions();
            navigateTo('home');
        });

        /* STORAGE SYNC */
        function saveData() {
            localStorage.setItem('ft_videos', JSON.stringify(state.videos));
